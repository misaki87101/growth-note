<div class="print-container" style="max-width: 800px; margin: 40px auto; padding: 40px; font-family: 'Helvetica Neue', Arial, sans-serif; color: #1a1a1a; background: #fff;">

  <%# 印刷ボタン（画面上のみ表示） %>
  <div class="no-print" style="text-align: right; margin-bottom: 20px;">
    <button onclick="window.print();" style="padding: 10px 20px; background: #1a1a1a; color: #fff; border: none; cursor: pointer; font-size: 11px; letter-spacing: 0.1em;">PRINT SHEET</button>
    <%= link_to "EDIT", edit_lesson_archive_path(@lesson_archive), style: "margin-left: 10px; font-size: 11px; color: #666; text-decoration: none;" %>
  </div>

  <%# --- セクション1: 講習概要（日報部分） --- %>
  <div style="border: 2px solid #1a1a1a; padding: 30px; margin-bottom: 40px; position: relative;">
    <div style="position: absolute; top: -12px; left: 20px; background: #fff; padding: 0 10px; font-size: 12px; font-weight: bold; letter-spacing: 0.2em;">LESSON PLAN</div>
    
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 15px;">
      <h1 style="font-size: 24px; margin: 0; font-weight: 500;"><%= @lesson_archive.title %></h1>
      <div style="font-size: 14px; font-family: 'Georgia', serif;"><%= @lesson_archive.lesson_date.strftime("%Y / %m / %d") %></div>
    </div>

    <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px;">
      <%# 左側：スケジュール %>
      <div>
        <h3 style="font-size: 11px; color: #999; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px;">Schedule & Contents</h3>
        <div style="font-size: 13px; line-height: 1.8; white-space: pre-wrap;"><%= @lesson_archive.schedule %></div>
      </div>
      <%# 右側：商材・伝達 %>
      <div>
        <div style="margin-bottom: 25px;">
          <h3 style="font-size: 11px; color: #999; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px;">Items</h3>
          <div style="font-size: 12px; line-height: 1.6; padding: 10px; background: #f9f9f9;"><%= @lesson_archive.items %></div>
        </div>
        <% if @lesson_archive.notice.present? %>
          <div>
            <h3 style="font-size: 11px; color: #d9534f; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px;">Notice</h3>
            <div style="font-size: 12px; line-height: 1.6; color: #d9534f; font-weight: 500;"><%= @lesson_archive.notice %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# --- セクション2: 生徒別フィードバック（一覧） --- %>
  <div style="page-break-before: auto;">
    <h2 style="font-size: 14px; border-left: 4px solid #1a1a1a; padding-left: 15px; margin-bottom: 25px; letter-spacing: 0.1em;">STUDENT FEEDBACKS (<%= @feedbacks.count %>)</h2>
    
    <% if @feedbacks.any? %>
      <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
        <thead>
          <tr style="border-bottom: 1px solid #1a1a1a; text-align: left;">
            <th style="padding: 10px; width: 100px;">NAME</th>
            <th style="padding: 10px;">ADVICE</th>
          </tr>
        </thead>
        <tbody>
          <% @feedbacks.each do |fb| %>
            <tr style="border-bottom: 1px solid #eee;">
              <td style="padding: 15px 10px; font-weight: bold; vertical-align: top;"><%= fb.student&.name %></td>
              <td style="padding: 15px 10px; line-height: 1.6; color: #444;">
                <%# 講師間メモがあれば優先的に表示 %>
                <% if fb.secret.present? %>
                  <div style="margin-bottom: 8px; color: #d9534f; font-size: 11px;">[講師用メモ] <%= fb.secret %></div>
                <% end %>
                <%= fb.content.truncate(200) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div style="text-align: center; padding: 40px; border: 1px dashed #ccc; color: #999; font-size: 12px;">
        この講習に紐づくフィードバックはまだありません。
      </div>
    <% end %>
  </div>

  <div class="no-print" style="text-align: right; margin-bottom: 20px; display: flex; justify-content: flex-end; align-items: center; gap: 15px;">
  <%# 一覧に戻る %>
  <%= link_to "BACK TO LIST", lesson_archives_path, style: "font-size: 11px; color: #999; text-decoration: none; letter-spacing: 0.1em; border-bottom: 1px solid #eee;" %>

  <%# 削除ボタン（講師のみ） %>
  <%= link_to "DELETE", lesson_archive_path(@lesson_archive), 
      data: { turbo_method: :delete, turbo_confirm: "この講習記録を削除してもよろしいですか？（紐づいているフィードバックは削除されません）" }, 
      style: "font-size: 11px; color: #d9534f; text-decoration: none; letter-spacing: 0.1em;" %>
</div>

</div>


<%# 印刷用スタイル設定 %>
<style>
  @media print {
    body { background: white !important; margin: 0; padding: 0; }
    .no-print { display: none !important; }
    .print-container { width: 100% !important; max-width: none !important; margin: 0 !important; padding: 20px !important; border: none !important; }
    table { page-break-inside: auto; }
    tr { page-break-inside: avoid; page-break-after: auto; }
  }
</style>