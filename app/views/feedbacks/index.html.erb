<%# app/views/feedbacks/index.html.erb %>
<div style="max-width: 700px; margin: 60px auto; padding: 0 20px; font-family: 'Helvetica Neue', Arial, sans-serif; color: #1a1a1a;">
  
  <%# タイトル %>
  <div style="text-align: center; margin-bottom: 60px;">
    <h1 style="font-size: 22px; font-weight: 300; letter-spacing: 0.15em; margin-bottom: 10px; text-transform: uppercase;">My Growth Note</h1>
    <div style="font-size: 10px; color: #999; letter-spacing: 0.2em;">LEARNING ARCHIVE</div>
  </div>

  <%# ナビゲーションメニュー app/views/shared/_nav.html.erb%>
  <%= render 'shared/nav' %>

  <% if current_user.teacher? %>
    <%# 承認待ちの生徒がいる場合だけ表示 %>
    <% pending_count = GroupUser.where(group_id: current_user.group_ids, accepted: false).count %>
    <% if pending_count > 0 %>
      <div style="background: #fafafa; border: 1px solid #1a1a1a; padding: 20px; margin-bottom: 40px; text-align: center;">
        <div style="font-size: 10px; color: #1a1a1a; letter-spacing: 0.2em; margin-bottom: 10px;">PENDING REQUESTS</div>
        <div style="font-size: 14px; font-weight: 300; margin-bottom: 15px;">
          現在、<%= pending_count %>名の生徒がクラスへの参加を待っています。
        </div>
        <%= link_to "承認待ちリストを確認する", pending_group_users_path, style: "font-size: 11px; color: #fff; background: #1a1a1a; text-decoration: none; padding: 8px 25px; letter-spacing: 0.1em;" %>
      </div>
    <% end %>
  <% end %>

  <%# ヘッダー部分 %>
  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 40px; border-bottom: 1px solid #1a1a1a; padding-bottom: 15px;">
    <h2 style="font-size: 22px; font-weight: 300; letter-spacing: 0.15em; margin: 0;">FEEDBACKS</h2>
    <%# 先生の時だけ投稿ボタンを表示 %>
    <% if current_user.teacher? %>
      <%= link_to "New Post", new_feedback_path, style: "font-size: 11px; color: #1a1a1a; text-decoration: none; letter-spacing: 0.1em; border: 1px solid #1a1a1a; padding: 8px 20px;" %>
    <% end %>
  </div>

  
<%# 先生の時だけ絞り込みフォームを表示 %>
<% if current_user.teacher? %>
  <div style="margin-bottom: 40px;">
    <%= form_with url: feedbacks_path, method: :get, local: true do |f| %>
      <div style="display: flex; gap: 10px; align-items: center;">
        <span style="font-size: 10px; letter-spacing: 0.1em; color: #999;">FILTER:</span>
        <%= f.collection_select :student_id, @students, :id, :name, 
            { include_blank: "生徒を選択", selected: params[:student_id] }, 
            { style: "border: none; border-bottom: 1px solid #e5e5e5; padding: 5px; font-size: 12px; color: #1a1a1a; background: transparent; border-radius: 0; outline: none;" } %>
        <%= f.submit "SEARCH", style: "background: none; border: none; font-size: 10px; letter-spacing: 0.1em; cursor: pointer; color: #666;" %>
        <% if params[:student_id].present? %>
          <%= link_to "CLEAR", feedbacks_path, style: "font-size: 10px; color: #ccc; text-decoration: none; margin-left: 10px;" %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
  

  <%# リスト部分 %>
  <div style="display: flex; flex-direction: column;">
    <% @feedbacks.each do |feedback| %>
      <%= link_to feedback_path(feedback), style: "text-decoration: none; color: inherit; display: block; border-bottom: 1px solid #f0f0f0; padding: 25px 0; transition: background 0.2s; width: 100%;" do %>
        <div style="display: flex; align-items: flex-start; gap: 25px; width: 100%;" onmouseover="this.style.backgroundColor='#fafafa'" onmouseout="this.style.backgroundColor='transparent'">
      
          <%# 1. スコア & アイコン（左側固定・デザイン維持） %>
          <div style="width: 45px; text-align: center; flex-shrink: 0;">
            <div style="font-size: 20px; font-family: 'Georgia', serif; font-weight: 300; border-bottom: 1px solid #1a1a1a; display: inline-block; min-width: 25px;">
              <%= feedback.rating %>
            </div>
            <div style="font-size: 8px; color: #999; margin-top: 5px; margin-bottom: 10px;">SCORE</div>
            
            <div style="display: flex; flex-direction: column; align-items: center; gap: 5px;">
              <% if feedback.new_arrival? %>
                <span style="font-size: 8px; color: #fff; background: #1a1a1a; padding: 1px 4px; letter-spacing: 0.05em; display: inline-block;">NEW!</span>
              <% end %>
              <% if feedback.draft? %>
                <span style="font-size: 8px; color: #999; border: 1px solid #eee; padding: 1px 4px; letter-spacing: 0.05em; font-weight: bold; flex-shrink: 0;">下書き</span>
              <% end %>
            </div>
          </div>

          <%# 2. メイン情報（すべて左寄せに統合して幅を確保） %>
          <div style="flex-grow: 1; overflow: hidden;">
            <%# 日付 %>
            <div style="font-size: 10px; color: #999; letter-spacing: 0.05em; margin-bottom: 4px;">
              <%= feedback.lesson_date.strftime("%Y . %m . %d") %>
            </div>

            <%# 講習名：スマホ幅を考慮して12文字で省略（お好みに合わせて調整可） %>
            <div style="font-size: 16px; font-weight: 500; color: #1a1a1a; letter-spacing: 0.02em; margin-bottom: 6px; line-height: 1.3;">
              <%= feedback.title.present? ? feedback.title.truncate(12) : "Untitled Lesson" %>
            </div>

            <%# 名前：タイトルの下に配置して窮屈さを解消 %>
            <% if current_user.teacher? %>
              <div style="font-size: 9px; color: #aaa; letter-spacing: 0.1em; text-transform: uppercase;">
                STUDENT: <span style="color: #666;"><%= feedback.student&.name || "DELETED USER" %></span>
              </div>
            <% end %>

            <% if current_user.student? %>
              <div style="font-size: 9px; color: #aaa; letter-spacing: 0.1em; text-transform: uppercase;">
                INSTRUCTOR: <span style="color: #666;"><%= feedback.teacher&.name || "UNKNOWN" %></span>
              </div>
            <% end %>
          </div>

        </div>
      <% end %>
    <% end %>
  </div>
